{
  "name": "papertrade-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "build": "node scripts/prepare-assets.mjs",
    "dev": "node scripts/server.mjs",
    "monitor": "node scripts/monitor.mjs",
    "cf:dev": "wrangler dev",
    "cf:login": "wrangler login --use-keyring --scopes account:read user:read workers_scripts:write d1:write",
    "cf:whoami": "wrangler whoami",
    "cloud:setup": "node scripts/cloudflare-setup.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": { "wrangler": "4.149.0" }
}
